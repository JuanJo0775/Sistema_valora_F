{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "https://valora-api-faau.onrender.com/v1/:path*"
    },
    {
      "source": "/productos/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|TelegramBot|LinkedInBot|Slackbot|Discordbot|SkypeUriPreview|Pinterest|Embedly|redditbot).*"
        }
      ],
      "destination": "/api/og-producto?id=:id"
    },
    {
      "source": "/((?!v1/|api/).*)",
      "destination": "/index.html"
    }
  ]
}
